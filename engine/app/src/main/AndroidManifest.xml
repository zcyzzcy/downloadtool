<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载完成的系统通知（Android 13+ 运行时再请求一次授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 9 及以下读写公共下载目录需要；10+ 走系统直通 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ 自制相册读媒体库视频；14+ 用户可只授「选中的视频」（部分访问）也够列表用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 11+ 写公共 下载/vd 需要"所有文件访问"（个人工具 App；未授权时退应用私有目录，
         表现为：文件管理器看不到、图库不显示、打不开文件夹。首页会引导授权） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- v1.99 下载保活前台服务：有活跃任务时进程保持前台优先级，退后台不被系统杀 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 其他 App 里点「分享」可以把链接/text 直接发给本 App -->
            <intent-filter android:label="下载到百宝箱">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <!-- 原生视频播放页：WebView 解不了 H.265 等编码（有声无画），这里走系统解码器。
             configChanges 带上旋转：转屏不重建 Activity，画面不闪断 -->
        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity android:name=".MagnetActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- v1.11 AI 生图 / v1.12 证件照制作：均已按用户要求整体移除 -->

        <!-- v1.4 图片合并：压缩包按名称排序提取 → 新文件夹里 01 起连续重命名；v1.5 起支持续接已有文件夹 -->
        <activity
            android:name=".ZipMergeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />



        <!-- App 内登录窗口 -->
        <activity
            android:name=".LoginWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- v1.99 下载保活：空壳前台服务，由 LocalEngine 任务计数启停（dataSync 类型，
             targetSdk 34 强制要求声明类型；通知不打扰：IMPORTANCE_LOW 无声音） -->
        <service
            android:name=".VdService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 把下载的文件以 content:// 授权给系统播放器等外部 App 打开 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.palworld.vd.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
